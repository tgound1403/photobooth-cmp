    <!-- Camera descriptions, resolved by id in CameraProfile.subtitleText -->
    <string name="camera_classic35_subtitle">Màu film ấm, hạt nhẹ, khung ngày cam. Hợp chân dung, đường phố, kỷ niệm</string>
    <string name="camera_fuji_mini_subtitle">Xanh lá tươi, bão hòa nhẹ, rò sáng mềm. Hợp du lịch, cây cối, bạn bè</string>
    <string name="camera_golden_subtitle">Nắng vàng ấm, rò sáng, nâng bóng nhẹ. Hợp hoàng hôn, picnic, chân dung ngoài trời</string>
    <string name="camera_night_subtitle">Tông trung tính, bóng nâng nhẹ, hạt dày, flash gắt. Hợp đêm phố, đèn neon, trời mưa</string>
    <string name="camera_silver_subtitle">Đen trắng hạt thô, tương phản cao, khung vuông. Hợp chân dung, kiến trúc, phố</string>
    <string name="camera_jp_001_subtitle">Vàng ấm đậm, sáng mờ dịu. Hợp nắng chiều, chân dung ấm áp.</string>
    <string name="camera_jp_002a_subtitle">Sáng, mát nhẹ, màu giữ gần gốc. Hợp đời thường, phố, du lịch.</string>
    <string name="camera_jp_002b_subtitle">Sáng, mát, ngả xanh lá và nâng bóng mạnh. Hợp cây cối, phong cảnh, trời mờ.</string>
    <string name="camera_jp_002c_subtitle">Rất sáng, nhạt, nâng bóng, bão hòa thấp. Hợp chân dung nhẹ, trong nhà sáng.</string>
    <string name="camera_jp_002d_subtitle">Tối, mát, màu đậm hơn. Hợp phố đêm, đèn đường, ảnh thiếu sáng.</string>
    <string name="camera_jp_002e_subtitle">Sáng, ngả hồng tím, tương phản cao. Hợp chân dung, đồ ăn, nắng chiều.</string>
    <string name="camera_jp_003_subtitle">Sáng trong, mát nhẹ, màu sạch. Hợp ảnh hằng ngày, cây cối, chân dung</string>
    <string name="camera_jp_004_subtitle">Sáng mịn, da sáng, màu nhạt. Hợp chân dung, selfie, trong nhà sáng.</string>
    <string name="camera_jp_005_subtitle">Da sáng trong, tông mát dịu. Hợp chân dung ngoài trời.</string>
    <string name="camera_jp_006_subtitle">Điện ảnh trầm, bóng ấm, vùng sáng mát. Hợp cảnh tối, đèn đường, phim ngắn</string>
    <string name="camera_jp_007_subtitle">Cam – xanh kiểu điện ảnh, cân bằng. Hợp đường phố, kiến trúc, hoàng hôn.</string>
    <string name="camera_jp_008_subtitle">Sáng, nét, màu sạch kiểu Instagram. Hợp du lịch, check-in, đồ ăn.</string>
    <string name="camera_jp_009_subtitle">Sáng ấm màu caramel, màu nhạt mịn. Hợp đám cưới, chân dung, trong nhà.</string>
    <string name="camera_jp_010_subtitle">Sáng ấm cổ điển, da mịn. Hợp đám cưới, tiệc, chân dung.</string>
    <string name="camera_jp_011_subtitle">Sáng mờ, nâng bóng, màu dịu. Hợp cây cối, rừng, ảnh nghệ thuật.</string>
    <string name="camera_jp_012_subtitle">Sáng, tương phản, hơi mát kiểu phim Hồng Kông. Hợp phố đêm, đường phố.</string>
    <string name="camera_jp_013_subtitle">Sáng mờ như phim nghệ thuật, màu nhạt. Hợp ảnh tâm trạng, nội thất.</string>
    <string name="camera_jp_014_subtitle">Phim mờ, bóng nâng, tương phản thấp. Hợp cà phê, ngày nhiều mây, tâm trạng.</string>
    <string name="camera_jp_015_subtitle">Phim Nhật sáng, tông mát dịu. Hợp đời thường, trời xanh, phố.</string>
    <string name="camera_jp_016_subtitle">Vàng ấm đậm, sáng và rực. Hợp phố đêm, đèn vàng, quán ăn.</string>
    <string name="camera_jp_017_subtitle">Morandi mờ ấm, bão hòa thấp. Hợp cây cối, nội thất, tĩnh vật.</string>
    <string name="camera_jp_018_subtitle">Rất sáng, sạch, trắng mát. Hợp trong nhà, sản phẩm, phòng trắng.</string>
    <string name="camera_jp_019_subtitle">Phim sáng nhẹ, màu dịu. Hợp quán cà phê, đồ ăn, ảnh đời thường.</string>
    <string name="camera_jp_020_subtitle">Kem sáng, màu nhạt mịn. Hợp chân dung, đồ ăn, nội thất ấm.</string>
    <string name="camera_jp_021_subtitle">Caramel ấm, bóng nâng. Hợp đồ ăn, sản phẩm, đồ handmade.</string>
    <string name="camera_jp_022_subtitle">Morandi mờ, bóng ấm sáng mát. Hợp phong cảnh, nội thất, tâm trạng.</string>
    <string name="camera_jp_023_subtitle">Sáng, nét, màu dịu kiểu phim du lịch. Hợp đường phố, kiến trúc, chuyến đi</string>
    <string name="camera_jp_024_subtitle">Mát, sạch, màu tươi tương phản. Hợp ảnh sản phẩm, đường phố nắng, bầu trời xanh</string>
    <string name="camera_jp_025_subtitle">Cực sáng, thoáng, mờ. Hợp chân dung, ngày nắng, ảnh trong veo.</string>
    <string name="camera_jp_026_subtitle">Cam – xanh điện ảnh, sáng và nét. Hợp phong cảnh, biển núi, du lịch.</string>
    <string name="camera_jp_027_subtitle">Điện ảnh du lịch, sáng, nét. Hợp phong cảnh, thành phố, chuyến đi.</string>
    <string name="camera_jp_028_subtitle">Tối, trầm, ấm kiểu phim tài liệu. Hợp phố, chân dung chân thực, thiếu sáng.</string>
    <string name="camera_jp_029_subtitle">Nhẹ, mát, mơ. Hợp trẻ em, ngày nắng, ảnh vui.</string>
    <string name="camera_jp_030_subtitle">Xám Morandi ấm, nhạt dịu. Hợp tĩnh vật, nội thất, chân dung tối giản.</string>
    <string name="camera_jp_031_subtitle">Morandi sáng nhẹ, nâng bóng. Hợp tĩnh vật, hoa, đồ vật.</string>
    <string name="camera_jp_032_subtitle">Sáng mát, màu nhạt như nắng biển. Hợp biển, trời nắng, du lịch.</string>
    <string name="camera_jp_033_subtitle">Nâu chocolate trầm, tối, ấm. Hợp chân dung ấm, cà phê, thiếu sáng.</string>
    <string name="camera_jp_034_subtitle">Sáng mạnh, tương phản cao, rất điện ảnh. Hợp thành phố, phố đêm.</string>
    <string name="camera_jp_035_subtitle">Xám thanh lịch, màu rất nhạt. Hợp chân dung, thời trang, tối giản.</string>
    <string name="camera_jp_036_subtitle">Sáng, mát, nét kiểu phố Nhật. Hợp đường phố, phong cảnh, trời xanh.</string>
    <string name="camera_jp_037_subtitle">Phim sáng mạnh, mờ nhẹ, chất cuộn film. Hợp ngày nắng, chân dung, kỷ niệm.</string>
