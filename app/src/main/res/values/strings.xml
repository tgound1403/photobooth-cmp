    <string name="camera_classic35_subtitle">Warm film color, light grain, orange date stamp. Great for portraits, street, keepsakes</string>
    <string name="camera_fuji_mini_subtitle">Fresh greens, gentle saturation, soft light leaks. Great for travel, plants, friends</string>
    <string name="camera_golden_subtitle">Warm golden sun, light leaks, slightly lifted shadows. Great for sunsets, picnics, outdoor portraits</string>
    <string name="camera_night_subtitle">Neutral tones, lifted shadows, heavy grain, harsh flash. Great for night streets, neon, rainy days</string>
    <string name="camera_silver_subtitle">Coarse-grain black and white, high contrast, square frame. Great for portraits, architecture, streets</string>
    <string name="camera_jp_001_subtitle">Deep warm yellow, soft hazy light. Great for afternoon sun, warm portraits.</string>
    <string name="camera_jp_002a_subtitle">Bright, slightly cool, colors close to the original. Great for everyday, streets, travel.</string>
    <string name="camera_jp_002b_subtitle">Bright, cool, leaning green with strongly lifted shadows. Great for plants, landscapes, overcast days.</string>
    <string name="camera_jp_002c_subtitle">Very bright, pale, lifted shadows, low saturation. Great for soft portraits, bright interiors.</string>
    <string name="camera_jp_002d_subtitle">Dark, cool, richer color. Great for night streets, street lamps, low-light shots.</string>
    <string name="camera_jp_002e_subtitle">Bright, pink-purple tint, high contrast. Great for portraits, food, afternoon sun.</string>
    <string name="camera_jp_003_subtitle">Clear and bright, slightly cool, clean color. Great for daily shots, plants, portraits</string>
    <string name="camera_jp_004_subtitle">Smooth and bright, fair skin, pale color. Great for portraits, selfies, bright interiors.</string>
    <string name="camera_jp_005_subtitle">Clear fair skin, soft cool tones. Great for outdoor portraits.</string>
    <string name="camera_jp_006_subtitle">Moody cinematic, warm shadows, cool highlights. Great for dark scenes, street lamps, short films</string>
    <string name="camera_jp_007_subtitle">Balanced cinematic orange and teal. Great for streets, architecture, sunsets.</string>
    <string name="camera_jp_008_subtitle">Bright, sharp, clean Instagram-style color. Great for travel, check-ins, food.</string>
    <string name="camera_jp_009_subtitle">Warm bright caramel, smooth pale color. Great for weddings, portraits, interiors.</string>
    <string name="camera_jp_010_subtitle">Classic warm brightness, smooth skin. Great for weddings, parties, portraits.</string>
    <string name="camera_jp_011_subtitle">Hazy bright, lifted shadows, soft color. Great for plants, forests, art photography.</string>
    <string name="camera_jp_012_subtitle">Bright, contrasty, slightly cool Hong Kong film look. Great for night streets, street photography.</string>
    <string name="camera_jp_013_subtitle">Hazy bright like an art film, pale color. Great for moody shots, interiors.</string>
    <string name="camera_jp_014_subtitle">Faded film, lifted shadows, low contrast. Great for cafés, cloudy days, mood shots.</string>
    <string name="camera_jp_015_subtitle">Bright Japanese film, soft cool tones. Great for everyday, blue sky, streets.</string>
    <string name="camera_jp_016_subtitle">Deep warm yellow, bright and vivid. Great for night streets, yellow lights, eateries.</string>
    <string name="camera_jp_017_subtitle">Warm hazy Morandi, low saturation. Great for plants, interiors, still life.</string>
    <string name="camera_jp_018_subtitle">Very bright, clean, cool white. Great for interiors, products, white rooms.</string>
    <string name="camera_jp_019_subtitle">Light bright film, soft color. Great for cafés, food, everyday shots.</string>
    <string name="camera_jp_020_subtitle">Bright cream, smooth pale color. Great for portraits, food, warm interiors.</string>
    <string name="camera_jp_021_subtitle">Warm caramel, lifted shadows. Great for food, products, handmade items.</string>
    <string name="camera_jp_022_subtitle">Hazy Morandi, warm shadows, cool highlights. Great for landscapes, interiors, mood shots.</string>
    <string name="camera_jp_023_subtitle">Bright, sharp, soft color like travel film. Great for streets, architecture, trips</string>
    <string name="camera_jp_024_subtitle">Cool, clean, fresh contrasty color. Great for product shots, sunny streets, blue sky</string>
    <string name="camera_jp_025_subtitle">Ultra bright, airy, hazy. Great for portraits, sunny days, crystal-clear shots.</string>
    <string name="camera_jp_026_subtitle">Bright, sharp cinematic orange and teal. Great for landscapes, sea and mountains, travel.</string>
    <string name="camera_jp_027_subtitle">Bright, sharp travel cinema. Great for landscapes, cities, trips.</string>
    <string name="camera_jp_028_subtitle">Dark, moody, warm documentary style. Great for streets, candid portraits, low light.</string>
    <string name="camera_jp_029_subtitle">Light, cool, dreamy. Great for kids, sunny days, fun shots.</string>
    <string name="camera_jp_030_subtitle">Warm Morandi gray, soft and pale. Great for still life, interiors, minimalist portraits.</string>
    <string name="camera_jp_031_subtitle">Light Morandi, lifted shadows. Great for still life, flowers, objects.</string>
    <string name="camera_jp_032_subtitle">Bright and cool, pale color like seaside sun. Great for beaches, sunny days, travel.</string>
    <string name="camera_jp_033_subtitle">Deep chocolate brown, dark and warm. Great for warm portraits, cafés, low light.</string>
    <string name="camera_jp_034_subtitle">Strong brightness, high contrast, very cinematic. Great for cities, night streets.</string>
    <string name="camera_jp_035_subtitle">Elegant gray, very pale color. Great for portraits, fashion, minimalism.</string>
    <string name="camera_jp_036_subtitle">Bright, cool, sharp Japanese street style. Great for streets, landscapes, blue sky.</string>
    <string name="camera_jp_037_subtitle">Strong bright film, slightly hazy, film-roll feel. Great for sunny days, portraits, keepsakes.</string>
